{
  "name": "filesystem-source",
  "config": {
    "tasks.max": "1",
    "connector.class": "com.github.jcustenborder.kafka.connect.spooldir.SpoolDirCsvSourceConnector",
    "input.path": "/data",
    "input.file.pattern": "stores-.*\\.csv",
    "error.path": "/data/errors",
    "finished.path": "/data/finished",
    "halt.on.error": "false",
    "topic": "stores",
    "csv.first.row.as.header": "false",
    "csv.column.names": "id,name,city,state,country",
    "schema.generation.enabled": "false",
    "cleanup.policy": "DELETE",
    "file.minimum.age.ms": "90000",
    "key.schema": "{\"name\":\"com.example.stores.StoreKey\",\"type\":\"STRUCT\",\"isOptional\":false,\"fieldSchemas\":{\"id\":{\"type\":\"STRING\",\"isOptional\":false}}}",
    "value.schema": "{\"name\":\"com.example.stores.Store\",\"type\":\"STRUCT\",\"isOptional\":false,\"fieldSchemas\":{\"id\":{\"type\":\"STRING\",\"isOptional\":false},\"name\":{\"type\":\"STRING\",\"isOptional\":true},\"city\":{\"type\":\"STRING\",\"isOptional\":true},\"state\":{\"type\":\"STRING\",\"isOptional\":true},\"country\":{\"type\":\"STRING\",\"isOptional\":true}}}"
  }
}